<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkspaceSetupActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Workspace Type Spinner -->
        <Spinner
            android:id="@+id/spinner_workspace_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:entries="@array/workspace_types"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Workspace Name EditText -->
        <EditText
            android:id="@+id/etWorkspaceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Workspace Name"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_workspace_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layoutApartmentFields"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/etWorkspaceName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/etApartmentComplexName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Apartment Complex Name"
                android:inputType="textCapWords"
                android:imeOptions="actionNext"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etFloorNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Floor Number"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>

        <!-- Address Input -->
        <LinearLayout
            android:id="@+id/layoutAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutApartmentFields"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Hidden Places Autocomplete Fragment -->
            <fragment
                android:id="@+id/autocomplete_fragment"
                android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addressInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Street Address*"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_search"
                    android:background="@drawable/edit_text_background"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/apartmentSuiteLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Apartment suite, floor (optional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApartmentSuite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/businessNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Business name (optional)"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Pets Switch -->
        <Switch
            android:id="@+id/switch_pets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do you have pets?"
            app:layout_constraintTop_toBottomOf="@id/layoutAddress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Expected Occupants Text -->
        <TextView
            android:id="@+id/tv_expected_occupants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Number of Expected Total Occupants (Including Yourself)"
            app:layout_constraintTop_toBottomOf="@id/switch_pets"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Expected Occupants Spinner -->
        <Spinner
            android:id="@+id/spinner_expected_occupants"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:entries="@array/expected_occupants"
            app:layout_constraintTop_toBottomOf="@id/tv_expected_occupants"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Occupants Details Layout -->
        <LinearLayout
            android:id="@+id/layout_occupants_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/spinner_expected_occupants"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <!-- Dynamic content for occupants added programmatically -->

        </LinearLayout>

        <!-- Pets Count Text -->
        <TextView
            android:id="@+id/tv_expected_pets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Number of Pets"
            app:layout_constraintTop_toBottomOf="@id/layout_occupants_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Pets Count Spinner -->
        <Spinner
            android:id="@+id/spinner_expected_pets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:entries="@array/pet_count"
            app:layout_constraintTop_toBottomOf="@id/tv_expected_pets"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Pets Details Layout -->
        <LinearLayout
            android:id="@+id/layout_pets_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/spinner_expected_pets"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <!-- Dynamic content for pets added programmatically -->

        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            app:layout_constraintTop_toBottomOf="@id/layout_pets_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

